# BabyNova. Copy to ".env" next to docker-compose.yml. Never commit ".env".

HOST_PORT=8012

# ---- Server -----------------------------------------------------------------
# When set, /reset and /admin/reload require "Authorization: Bearer <token>".
ADMIN_TOKEN=
# When set, chat, agent tools and /builtin-tools require "X-API-Key: <token>" (or "Authorization: Bearer <token>").
# The backend sends it itself when an agent calls its own tools.
API_TOKEN=
# When set, channel webhooks (GoHighLevel) require the header "X-Webhook-Token: <token>".
# Add it as a custom header in the GHL webhook action.
WEBHOOK_TOKEN=

# ---- Models -----------------------------------------------------------------
# Providers to use, most preferred first, separated by commas: openai, anthropic (Claude), gemini.
# A provider left out of the list is never used. When the first one fails (no credits, bad key, outage, timeout)
# the call is answered by the next one, and the failed one is skipped for a while. Empty = openai only.
LLM_PROVIDERS=openai
# Provider keys and models. Only the listed providers need a key; a listed provider without one is skipped.
OPENAI_API_KEY=
# Empty = gpt-4o-mini.
OPENAI_MODEL=
ANTHROPIC_API_KEY=
# Empty = claude-haiku-5-5.
ANTHROPIC_MODEL=
GEMINI_API_KEY=
# Empty = gemini-2.5-flash.
GEMINI_MODEL=
# Seconds to wait for one provider before handing the call to the next (empty = 60).
LLM_TIMEOUT_SECONDS=
# Seconds a provider with no credits or a bad key is skipped before it is tried again (empty = 300).
LLM_COOLDOWN_SECONDS=

# ---- Persistence ------------------------------------------------------------
# Empty = a sessions.db file per agent inside ./bundles.
DATABASE_URL=
# Two ways to configure Postgres (neither set = SQLite per agent):
#   (a) DATABASE_URL: one full connection string. Used only when DATABASE_HOST is empty.
#   (b) DATABASE_HOST + the pieces below: takes priority whenever DATABASE_HOST is set (DATABASE_URL is
#       then ignored). The password is URL-encoded for you, so any character is fine.
# DATABASE_REGION: empty = the host as is (Render's internal host, for a deployed app); set = appended as
# ".<region>" (external host, for a machine outside Render's network). Do not include the leading dot.
DATABASE_HOST=
DATABASE_REGION=
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
# Maximum size of the shared connection pool (sessions + conversations table). Only with Postgres.
DATABASE_POOL_MAX_SIZE=5

# ---- GoHighLevel ------------------------------------------------------------
GHL_VERSION=v3
# The company's GHL token: used by the webhooks of both text agents and the built-in tools.
GHL_TOKEN=
# Id of the company's GHL location (sub-account); the token above belongs to it. Needed by every call that
# lists events, creates appointments or resolves contacts. It is the id in the app URL: .../location/<id>/...
GHL_LOCATION_ID=
# Only if this container must talk to SEVERAL GHL sub-accounts: "<location_id>:<TOKEN_ENV_VAR>,...".
# A location listed here uses that variable's token instead of GHL_TOKEN (built-in tools only).
# GHL_LOCATION_TOKEN_ENVS=

# ---- Global router ------------------------------------------------------------------
# true = respect filter: faced with hate, vulgarity or disdain the agent answers with a polite
# reminder and repeats the pending question; false = no filter.
GLOBAL_ROUTER_RESPECT_FILTER=true
# true = the model detects language changes; false = fixed phrases first, without calling the model.
GLOBAL_ROUTER_LANGUAGE_DETECTION=false

# ---- GoHighLevel messaging: memory, closing message, debug ----------------------------
# Days of inactivity (shared by every text agent) before the next inbound message starts a NEW
# conversation instead of continuing the existing one. Read at startup: restart to change it.
GHL_TEXT_HISTORY_MAX_DAYS=7
# WhatsApp blocks free-form messages 24 h after the contact's last one. A periodic sweep sends the
# agent's closing message to inactive threads at ~23:45; this is how often the sweep runs. Needs Postgres.
CLOSING_MESSAGE_SWEEP_INTERVAL_SECONDS=300
# Phones allowed to call the built-in `echo` debug tool (it sends a test message through GHL).
# Empty = nobody passes the filter.
ECHO_ALLOWED_PHONES=

# ---- Webhook gate shared by babynova_triage_obstetrico_text and babynova_surrogate_questions_text ----
# Comma-separated E.164 numbers the webhooks answer while the gate is on.
BN_DEV_ALLOWED_PHONES=
# true = answer only BN_DEV_ALLOWED_PHONES (empty list = ignore everyone); false = answer everyone.
BN_DEV_ENFORCE_PHONE_WHITELIST=true

# ---- Tool plugin: bundles/_tools/surrogacy ------------------------------
# Optional. One or several addresses (comma-separated) that get an e-mail for every booked
# appointment so the team can start the human follow-up. Empty = nothing is sent.
# ---- Croma (ADRES affiliation lookups, tool check_adres) ----
# Secret key of the Croma account (https://docs.usecroma.com). Without it the tool answers success=false.
CROMA_API_KEY=
# Optional: provider root and how long to wait for a live lookup (seconds).
CROMA_BASE_URL=https://api.croma.run
CROMA_TIMEOUT_SECONDS=60

BN_NOTIFICATION_EMAIL=

# ---- Calendars ---------------------------------------------------------------------
# Every calendar is declared by BN_<VARIABLE>_<KEY>. <KEY> is what tools send as calendar_type
# (REQUIRED in every BabyNova scheduling call; a call without it fails). To add a calendar, define its variables with a new key, e.g. CONTROL:
#   BN_GHL_CALENDAR_ID_<KEY>          GoHighLevel calendar
#   BN_GOOGLE_CLIENT_ID_<KEY>         Google OAuth client
#   BN_GOOGLE_CLIENT_SECRET_<KEY>
#   BN_GOOGLE_REFRESH_TOKEN_<KEY>
#   BN_GOOGLE_CALENDAR_ID_<KEY>       Google calendar id
# Scheduling parameters (all optional). In BabyNova an EMPTY duration / pre buffer / post buffer / min notice /
# date range is read from the GoHighLevel calendar by the -ghl tools; a value written here always wins.
# (BabyNova's Google tools use the values below, or defaults when empty.)
#   BN_DURATION_MINUTES_<KEY>      appointment length; also sent to GHL as `duration`, so it must be one of the
#                                   active durations of the GHL calendar (default 30)
#   BN_INTERVAL_MINUTES_<KEY>      minimum distance between the starts of the offered slots; 0 = offer every slot
#   BN_PRE_BUFFER_MINUTES_<KEY>    free time kept BEFORE each existing appointment
#   BN_POST_BUFFER_MINUTES_<KEY>   free time kept AFTER each existing appointment
#   BN_MIN_NOTICE_MINUTES_<KEY>    minimum notice before a slot; empty = the company's own rule
#   BN_DATE_RANGE_DAYS_<KEY>       how many days ahead slots are offered (GHL accepts at most 31)
# Its rules (hours, lunch, title) go in bundles/_tools/surrogacy/config/calendars.yaml.

# FT calendar (always exists)
BN_GOOGLE_CLIENT_ID_FT=
BN_GOOGLE_CLIENT_SECRET_FT=
BN_GOOGLE_REFRESH_TOKEN_FT=
BN_GOOGLE_CALENDAR_ID_FT=primary
BN_DURATION_MINUTES_FT=30
BN_INTERVAL_MINUTES_FT=0
BN_PRE_BUFFER_MINUTES_FT=0
BN_POST_BUFFER_MINUTES_FT=0
BN_MIN_NOTICE_MINUTES_FT=
BN_DATE_RANGE_DAYS_FT=14

# Example of an additional calendar:
# BN_GHL_CALENDAR_ID_<KEY>=
# BN_GOOGLE_CLIENT_ID_<KEY>=
# BN_GOOGLE_CLIENT_SECRET_<KEY>=
# BN_GOOGLE_REFRESH_TOKEN_<KEY>=
# BN_GOOGLE_CALENDAR_ID_<KEY>=
# BN_DURATION_MINUTES_<KEY>=
# BN_INTERVAL_MINUTES_<KEY>=
# BN_PRE_BUFFER_MINUTES_<KEY>=
# BN_POST_BUFFER_MINUTES_<KEY>=
# BN_MIN_NOTICE_MINUTES_<KEY>=
# BN_DATE_RANGE_DAYS_<KEY>=

# ---- Gmail sender (NOT a calendar): sends the notification e-mails ------------------
BN_GOOGLE_CLIENT_ID_GMAIL=
BN_GOOGLE_CLIENT_SECRET_GMAIL=
BN_GOOGLE_REFRESH_TOKEN_GMAIL=
BN_GMAIL_SENDER_EMAIL=

# ---- Development and testing (used by scripts/send_request.py and scripts/dev_tunnel.py on YOUR machine) ----
# The container ignores these; they are here so each company keeps all its settings in one file.
# Never commit real values (NGROK_TOKEN is a credential).
# HOST/PORT: where `python -m agent_backend` listens when you run it without Docker (the container is fixed to 0.0.0.0:8010).
HOST=127.0.0.1
PORT=8010
# Where send_request.py points by default: local, ngrok or render (empty = local).
SEND_REQUEST_DEFAULT_TARGET=
RENDER_BASE_URL=
NGROK_BASE_URL=
NGROK_TOKEN=
NGROK_DOMAIN=
# true/1 = close an ngrok tunnel that is already open before opening a new one.
NGROK_KILL_EXISTING=true
