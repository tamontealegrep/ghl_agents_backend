# Family Aims. Copy to ".env" next to docker-compose.yml. Never commit ".env".

HOST_PORT=8011

# ---- Server -----------------------------------------------------------------
# When set, /reset and /admin/reload require "Authorization: Bearer <token>".
ADMIN_TOKEN=
# When set, chat, agent tools and /builtin-tools require "X-API-Key: <token>" (or "Authorization: Bearer <token>").
# The backend sends it itself when an agent calls its own tools.
API_TOKEN=
# When set, channel webhooks (GoHighLevel) require the header "X-Webhook-Token: <token>".
# Add it as a custom header in the GHL webhook action.
WEBHOOK_TOKEN=

# ---- Models -----------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=

# ---- Persistence ------------------------------------------------------------
# Empty = a sessions.db file per agent inside ./bundles.
DATABASE_URL=
# Two ways to configure Postgres (neither set = SQLite per agent):
#   (a) DATABASE_URL: one full connection string. Used only when DATABASE_HOST is empty.
#   (b) DATABASE_HOST + the pieces below: takes priority whenever DATABASE_HOST is set (DATABASE_URL is
#       then ignored). The password is URL-encoded for you, so any character is fine.
# DATABASE_REGION: empty = the host as is (Render's internal host, for a deployed app); set = appended as
# ".<region>" (external host, for a machine outside Render's network). Do not include the leading dot.
DATABASE_HOST=
DATABASE_REGION=
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
# Maximum size of the shared connection pool (sessions + conversations table). Only with Postgres.
DATABASE_POOL_MAX_SIZE=5

# ---- GoHighLevel ------------------------------------------------------------
GHL_VERSION=v3
# The company's GHL token: used by the webhook of the text agent, the -ghl tools and the built-in tools.
GHL_TOKEN=
# Id of the company's GHL location (sub-account); the token above belongs to it. Needed by every call that
# lists events, creates appointments or resolves contacts. It is the id in the app URL: .../location/<id>/...
GHL_LOCATION_ID=
# Only if this container must talk to SEVERAL GHL sub-accounts: "<location_id>:<TOKEN_ENV_VAR>,...".
# A location listed here uses that variable's token instead of GHL_TOKEN (built-in tools only).
# GHL_LOCATION_TOKEN_ENVS=

# ---- Global router ------------------------------------------------------------------
# true = respect filter: faced with hate, vulgarity or disdain the agent answers with a polite
# reminder and repeats the pending question; false = no filter.
GLOBAL_ROUTER_RESPECT_FILTER=true
# true = the model detects language changes; false = fixed phrases first, without calling the model.
GLOBAL_ROUTER_LANGUAGE_DETECTION=false

# ---- GoHighLevel messaging: memory, closing message, debug ----------------------------
# Days of inactivity (shared by every text agent) before the next inbound message starts a NEW
# conversation instead of continuing the existing one. Read at startup: restart to change it.
GHL_TEXT_HISTORY_MAX_DAYS=7
# WhatsApp blocks free-form messages 24 h after the contact's last one. A periodic sweep sends the
# agent's closing message to inactive threads at ~23:45; this is how often the sweep runs. Needs Postgres.
CLOSING_MESSAGE_SWEEP_INTERVAL_SECONDS=300
# Phones allowed to call the built-in `echo` debug tool (it sends a test message through GHL).
# Empty = nobody passes the filter.
ECHO_ALLOWED_PHONES=

# ---- Webhook gate of family_aims_sam_text -----------------------------------------
# Comma-separated E.164 numbers the webhook answers while the gate is on.
FA_DEV_ALLOWED_PHONES=
# true = answer only FA_DEV_ALLOWED_PHONES (empty list = ignore everyone); false = answer everyone.
FA_DEV_ENFORCE_PHONE_WHITELIST=true

# ---- Tool plugin: bundles/_tools/desk ----------------------------------
# Optional. One or several addresses (comma-separated) that get an e-mail for every booked
# appointment so the team can start the human follow-up. Needs the Gmail sender below.
# Empty = nothing is sent.
FA_NOTIFICATION_EMAIL=

# Calendars. Every calendar is declared by FA_<VARIABLE>_<KEY>; <KEY> is what tools send as
# calendar_type (IVF when omitted). Variables per calendar: GHL_CALENDAR_ID, GOOGLE_CLIENT_ID,
# GOOGLE_CLIENT_SECRET, GOOGLE_REFRESH_TOKEN, GOOGLE_CALENDAR_ID, DURATION_MINUTES, INTERVAL_MINUTES,
# PRE_BUFFER_MINUTES, POST_BUFFER_MINUTES, MIN_NOTICE_MINUTES, DATE_RANGE_DAYS. Its rules go in bundles/_tools/desk/config/calendars.yaml.
# Scheduling parameters of every calendar (all optional). GoHighLevel computes the free slots with the
# settings of the GHL calendar; these values only DISCARD slots that do not meet them:
#   FA_DURATION_MINUTES_<KEY>      appointment length; also sent to GHL as `duration`, so it must be one of the
#                                   active durations of the GHL calendar (default 30)
#   FA_INTERVAL_MINUTES_<KEY>      minimum distance between the starts of the offered slots; 0 = offer every slot
#   FA_PRE_BUFFER_MINUTES_<KEY>    free time kept BEFORE each existing appointment
#   FA_POST_BUFFER_MINUTES_<KEY>   free time kept AFTER each existing appointment
#   FA_MIN_NOTICE_MINUTES_<KEY>    minimum notice before a slot; empty = the company's own rule
#   FA_DATE_RANGE_DAYS_<KEY>       how many days ahead slots are offered (GHL accepts at most 31)
# Family Aims keeps 10 minutes after every appointment (FA_POST_BUFFER_MINUTES_<KEY>) unless set otherwise.

# Google Calendar, one set per calendar key (IVF, SUR)
FA_GHL_CALENDAR_ID_IVF=
FA_GOOGLE_CLIENT_ID_IVF=
FA_GOOGLE_CLIENT_SECRET_IVF=
FA_GOOGLE_REFRESH_TOKEN_IVF=
FA_GOOGLE_CALENDAR_ID_IVF=
FA_DURATION_MINUTES_IVF=30
FA_INTERVAL_MINUTES_IVF=0
FA_PRE_BUFFER_MINUTES_IVF=0
FA_POST_BUFFER_MINUTES_IVF=10
FA_MIN_NOTICE_MINUTES_IVF=
FA_DATE_RANGE_DAYS_IVF=14

FA_GHL_CALENDAR_ID_SUR=
FA_GOOGLE_CLIENT_ID_SUR=
FA_GOOGLE_CLIENT_SECRET_SUR=
FA_GOOGLE_REFRESH_TOKEN_SUR=
FA_GOOGLE_CALENDAR_ID_SUR=
FA_DURATION_MINUTES_SUR=30
FA_INTERVAL_MINUTES_SUR=0
FA_PRE_BUFFER_MINUTES_SUR=0
FA_POST_BUFFER_MINUTES_SUR=10
FA_MIN_NOTICE_MINUTES_SUR=
FA_DATE_RANGE_DAYS_SUR=14

# Example of an additional calendar:
# FA_GHL_CALENDAR_ID_<KEY>=
# FA_GOOGLE_CLIENT_ID_<KEY>=
# FA_GOOGLE_CLIENT_SECRET_<KEY>=
# FA_GOOGLE_REFRESH_TOKEN_<KEY>=
# FA_GOOGLE_CALENDAR_ID_<KEY>=
# FA_DURATION_MINUTES_<KEY>=
# FA_INTERVAL_MINUTES_<KEY>=
# FA_PRE_BUFFER_MINUTES_<KEY>=
# FA_POST_BUFFER_MINUTES_<KEY>=
# FA_MIN_NOTICE_MINUTES_<KEY>=
# FA_DATE_RANGE_DAYS_<KEY>=

# Gmail sender (NOT a calendar): confirmation e-mails to patients and FA_NOTIFICATION_EMAIL
FA_GOOGLE_CLIENT_ID_GMAIL=
FA_GOOGLE_CLIENT_SECRET_GMAIL=
FA_GOOGLE_REFRESH_TOKEN_GMAIL=
FA_GMAIL_SENDER_EMAIL=

# ---- Development and testing (used by scripts/send_request.py and scripts/dev_tunnel.py on YOUR machine) ----
# The container ignores these; they are here so each company keeps all its settings in one file.
# Never commit real values (NGROK_TOKEN is a credential).
# HOST/PORT: where `python -m agent_backend` listens when you run it without Docker (the container is fixed to 0.0.0.0:8010).
HOST=127.0.0.1
PORT=8010
# Where send_request.py points by default: local, ngrok or render (empty = local).
SEND_REQUEST_DEFAULT_TARGET=
RENDER_BASE_URL=
NGROK_BASE_URL=
NGROK_TOKEN=
NGROK_DOMAIN=
# true/1 = close an ngrok tunnel that is already open before opening a new one.
NGROK_KILL_EXISTING=true
